# XmetaV x402 Server - Base Mainnet Configuration
# Copy this file to .env and fill in your actual values

# Your wallet address on Base Mainnet (receives USDC payments)
EVM_ADDRESS=0x4Ba6B07626E6dF28120b04f772C4a89CC984Cc80

# Production Coinbase Facilitator (Base Mainnet)
FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# Server port
PORT=4021

# Base Mainnet Network ID
NETWORK=eip155:8453

# OpenAI API Key (for voice features - optional)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ── Cross-Chain (Solana) Configuration ──
# Required for Base↔Solana bridge, Jupiter swaps, Kamino vaults

# Solana RPC URL (Helius, QuickNode, or mainnet-beta)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Solana private key (base58 encoded) — for signing bridge/swap txs
SOLANA_PRIVATE_KEY=your-bs58-encoded-solana-private-key

# EVM private key — for signing Base-side bridge transactions
EVM_PRIVATE_KEY=0xyour-evm-private-key

# Base RPC URL (Alchemy, Infura, etc.)
BASE_RPC_URL=https://mainnet.base.org
